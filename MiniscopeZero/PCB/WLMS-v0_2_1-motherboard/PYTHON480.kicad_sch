	(text "SHUTDOWN MODE\nTo conserve battery life in portable applications, the\nLMV881 can be disabled when the shutdown pin voltage is\npulled low. The shutdown pin is designed for 1.8V logic\nlevels, with thresholds independent of total supply voltage.\n\nThe shutdown pin cannot be left unconnected. In case shut down\noperation is not needed, the shutdown pin should be connected\nto V+ for normal operation. Leaving the shutdown pin floating\nwill result in an undefined operation modes, either shutdown\nor active, or even oscillating between the two modes.\n"
		(exclude_from_sim no)
		(at 221.615 131.445 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0a9a0c91-f3dc-49aa-8a33-c8e44a643c6a")
	)
